{
  "name": "neon-studio",
  "version": "0.1.0",
  "description": "Editor local de imagen, video, diseno y PDF.",
  "author": "fposca",
  "private": true,
  "main": "desktop/electron-main.js",
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"corepack pnpm run server\" \"corepack pnpm run client\"",
    "client": "vite --host 127.0.0.1",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "corepack pnpm run build && electron .",
    "dist:win": "corepack pnpm run build && node desktop/build-windows.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "firebase": "^12.19.0",
    "lucide-react": "^0.542.0",
    "multer": "^2.0.2",
    "paper": "^0.12.18",
    "pdfjs-dist": "^6.3.289",
    "potrace": "^2.1.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.0",
    "vite": "^7.1.4"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "firebase-tools": "^15.30.1"
  },
  "build": {
    "appId": "com.fposca.studio",
    "artifactName": "Neon-Studio-Setup-Windows.${ext}",
    "productName": "Neon Studio",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "dist/**",
      "desktop/**",
      "build/icon.png",
      "server/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
