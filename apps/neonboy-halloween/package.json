{
  "name": "neonboy-halloween-android",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "optimize:glasses": "node scripts/optimize-glasses.mjs",
    "build:web": "node --max-old-space-size=8192 ../../node_modules/vite/bin/vite.js build --config vite.android.config.js --configLoader runner",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
